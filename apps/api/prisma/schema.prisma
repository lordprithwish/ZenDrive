// Prisma schema for DarkDrive
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

// Tiny generic key-value store for admin-editable settings that need to
// survive a restart but don't warrant their own table — e.g. which storage
// backend new uploads go to (see apps/api/src/storage/index.ts).
model AppSetting {
  key   String @id
  value String
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())

  role                  UserRole  @default(USER)
  storageQuotaBytes     BigInt    @default(1073741824)
  upgradeRequestedAt    DateTime?
  upgradeRequestedBytes BigInt?
  disabledAt            DateTime?

  rootFolderId String? @unique
  rootFolder   Folder? @relation("UserRoot", fields: [rootFolderId], references: [id])

  // Second root folder, sibling to "My Drive" — the home of everything in
  // DarkGallery. Photos are ordinary File rows owned by the user, so they are
  // charged against the same storageQuotaBytes as the rest of the drive; they
  // just live outside the My Drive tree instead of inside it.
  photosRootFolderId String? @unique
  photosRoot         Folder? @relation("UserPhotosRoot", fields: [photosRootFolderId], references: [id])

  // Third root, "Synced Folders": one child per folder the desktop app keeps
  // in sync with a folder on someone's computer. Its direct children are what
  // the app offers to other devices, and what the web badges as synced.
  syncRootFolderId String? @unique
  syncRoot         Folder? @relation("UserSyncRoot", fields: [syncRootFolderId], references: [id])

  folders       Folder[]       @relation("FolderOwner")
  files         File[]         @relation("FileOwner")
  spaces        Space[]        @relation("SpaceOwner")
  memberships   SpaceMember[]
  shares        Share[]
  spaceInvites  SpaceInvite[]
  fileAccesses  FileAccess[]
  loginEvents   LoginEvent[]
  notifications Notification[]
  modifiedFiles File[]         @relation("FileLastModifiedBy")
  fileVersions  FileVersion[]
  activityLogs  ActivityLog[]
  deviceTokens  DeviceToken[]
  tempSessions  TempSession[]
  sharedFolders FolderMember[]
  telegramSession TelegramSession?
  telegramBotLink TelegramBotLink?
}

// Links a user's Telegram account for the Saved-Messages import (see
// routes/telegram.ts). `session` is a gramjs StringSession — a bearer
// credential for the *linked Telegram account itself*, not just this API, so
// treat it like the DeviceToken secret it effectively is.
model TelegramSession {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   String
  phone     String
  createdAt DateTime @default(now())
}

// Maps a Telegram chat to a DarkDrive user for the forward-to-bot import
// (see routes/telegram.ts's /bot/* endpoints). Set up by sending /start
// <code> to the bot after generating a link code — separate from
// TelegramSession, since this only needs the bot's own credentials, not a
// login to the user's personal Telegram account.
model TelegramBotLink {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String   @unique
  createdAt DateTime @default(now())
}

// A long-lived bearer credential for a non-browser client (the desktop sync
// daemon, a mobile app). Cookie sessions only work in a browser, so these
// clients send `Authorization: Bearer <token>` instead. Only the sha256 of the
// token is stored — the plaintext is shown once at creation, like any API key.
model DeviceToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  name       String
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// A time-boxed browser login for a device the user doesn't trust (a library
// PC, a friend's laptop). A signed-in device creates it and gets a one-time
// code — typed, scanned as a QR, or opened as a link; claiming it signs that
// other browser in until `expiresAt`. Enforced per request in passport's
// deserializeUser, not by the cookie: express-session re-extends the store
// TTL on every request, so the cookie alone would outlive the duration.
// Deleting the row ends the session (revoke, or sign-out on that device).
model TempSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // sha256 of the one-time code. Nulled on claim, which is what makes a code
  // work exactly once.
  codeHash   String?   @unique
  expiresAt  DateTime
  claimedAt  DateTime?
  // The browser that claimed it, for the session list.
  ip         String?
  userAgent  String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Discriminator the client uses to pick an icon/label — see
  // apps/api/src/lib/notify.ts for the fixed set of values in use.
  type      String
  title     String
  body      String?
  // Client-side path to navigate to when the notification is clicked, e.g.
  // "/drive/<folderId>". Null for notifications with nowhere to go.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model FileAccess {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  action     String
  accessedAt DateTime @default(now())

  @@index([userId, accessedAt])
  @@index([userId, fileId])
}

// Audit trail of mutations (upload, rename, move, trash, share, ...) on a
// file or folder. Exactly one of fileId/folderId is set. Separate from
// FileAccess, which only ever records view/download reads — merging the two
// would touch that model's existing view-count call sites (me.ts, admin.ts)
// for no benefit, since they only care about action="view"/"download".
model ActivityLog {
  id        String   @id @default(cuid())
  fileId    String?
  file      File?    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  // Small human-readable snapshot captured at event time, e.g. {from,to} for
  // a rename — the target itself may later be renamed again or deleted, so
  // the log needs its own copy rather than joining live state.
  detail    Json?
  createdAt DateTime @default(now())

  @@index([fileId, createdAt])
  @@index([folderId, createdAt])
  @@index([userId, fileId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Folder {
  id           String    @id @default(cuid())
  name         String
  color        String?
  ownerId      String
  owner        User      @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]  @relation("FolderChildren")
  files        File[]
  spaceId      String?
  space        Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  thumbnailKey String?
  isHidden     Boolean   @default(false)
  isTrashed    Boolean   @default(false)
  isStarred    Boolean   @default(false)
  // System-level (admin) recycle bin. When a user permanently deletes an item
  // from their own bin, it is not destroyed — it is stamped with `deletedAt` and
  // retained here so an admin can restore or purge it. `deletedById` records who
  // triggered the deletion. A non-null `deletedAt` always implies
  // `isTrashed = true`, so deleted items stay excluded from every normal listing.
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rootOf       User?          @relation("UserRoot")
  photosRootOf User?          @relation("UserPhotosRoot")
  syncRootOf   User?          @relation("UserSyncRoot")
  spaceRootOf  Space?         @relation("SpaceRoot")
  shares       Share[]
  shortcuts    FileShortcut[] @relation("FolderShortcuts")
  activityLogs ActivityLog[]
  members      FolderMember[]

  @@index([ownerId, parentId])
  @@index([spaceId, parentId])
  @@index([deletedAt])
}

// What a member may do about one kind of change: nothing, do it, or ask the
// owner, who then says yes or no (File.pending, FileShortcut.pending). The
// one permission layer of the two things that have members, a shared synced
// folder (FolderMember) and a space (SpaceMember), which are otherwise kept
// apart: each has its own members, and a space is never synced.
enum MemberCan {
  NO
  ASK
  YES
}

// Someone else who syncs one of a user's synced folders (a direct child of
// their "Synced Folders"). A member reads everything under it, on the web and
// from their own computers, and changes it as far as the two settings here
// allow (NO and NO is read-only); none can delete for good or share it on.
// What a member adds stays theirs (File.ownerId), and so on their quota.
model FolderMember {
  folderId  String
  folder    Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Adding files and folders, and changing, renaming and moving them. ASK
  // only stretches to adding files, which then wait unseen by everyone else.
  canUpload MemberCan @default(YES)
  // Binning. ASK only stretches to files, which stay until the owner agrees.
  canDelete MemberCan @default(YES)
  createdAt DateTime  @default(now())

  @@id([folderId, userId])
  @@index([userId])
}

model File {
  id                  String    @id @default(cuid())
  name                String
  ownerId             String
  owner               User      @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folderId            String
  folder              Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  spaceId             String?
  space               Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  size                BigInt
  mimeType            String
  storageKey          String    @unique
  // sha256 of the live content, computed while assembling the upload. Drives
  // the sync clients: it is how "this file changed" and "these two copies are
  // identical" are decided without re-transferring bytes. Null for files that
  // predate it and for URL imports.
  sha256              String?
  // Storage key of the generated preview thumbnail (a small JPEG), or null if
  // none exists yet. Populated by the thumbnail pipeline (see lib/thumbnails).
  thumbnailKey        String?
  // Generation outcome: "ready", "failed", or "unsupported". Null means not yet
  // attempted. Used to avoid re-running the pipeline on files that can't (or
  // didn't) produce a thumbnail.
  thumbnailState      String?
  // Container stream index of the audio track to play by default, set once
  // from the player/properties panel so multi-audio files (dual-audio rips,
  // commentary tracks) don't need reselecting on every open. Null = the
  // source's own default track.
  audioTrackIndex     Int?
  // Playback position in seconds, saved periodically while a video plays so
  // reopening it resumes where the user left off. Null = start from the top
  // (never played, or finished — see lib/thumbnails' onProgress(0) on `ended`).
  playbackPositionSec Float?
  // Storage key of the generated scrubbing-preview sprite sheet (a grid of
  // JPEG frames) for the seek bar, or null if none exists yet. `storyboardMeta`
  // holds the grid layout needed to slice it (interval/cols/rows/tileW/tileH).
  // See lib/thumbnails' storyboard generation.
  storyboardKey       String?
  storyboardState     String?
  storyboardMeta      Json?
  // When the photo/video was actually shot, as opposed to when it was
  // uploaded — what the gallery timeline sorts and groups by. Read from EXIF
  // at upload (see lib/exif) or supplied by the client, which on mobile knows
  // it exactly from the media library. Null for everything non-visual.
  takenAt             DateTime?
  // Source message this file was imported from, as "<chat>:<messageId>" (see
  // lib/telegram.ts). Checked *before* downloading so an interrupted import
  // resumes instead of re-fetching gigabytes and creating duplicate rows —
  // the unique index below is what makes a re-run idempotent. Null for
  // everything not imported from Telegram; Postgres treats those NULLs as
  // distinct, so the constraint doesn't collide across ordinary uploads.
  telegramRef         String?
  // Waiting on the owner of the shared synced folder it's in, for a member
  // who has to ask (FolderMember): "upload" is a file `pendingById` added,
  // which nobody else sees until the owner says yes; "delete" is one they
  // want binned, which stays as it is until then. Null for everything else.
  pending             String?
  pendingById         String?
  isHidden            Boolean   @default(false)
  isTrashed           Boolean   @default(false)
  isStarred           Boolean   @default(false)
  // Free-form user labels for organizing/filtering. No separate tag table —
  // there's no cross-file tag metadata (color, etc.) to justify one.
  tags                String[]  @default([])
  // See Folder.deletedAt — admin recycle bin retention for permanently-deleted
  // files. A non-null `deletedAt` always implies `isTrashed = true`.
  deletedAt           DateTime?
  deletedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Who uploaded the currently-live content (via "upload new version"). Null
  // means the content is still the original upload, so the author is just
  // `owner`. Kept separate from `owner`, which never changes on a version
  // swap, so past FileVersion rows can be attributed to whoever actually
  // authored that content at archive time — see files.ts's replace handler.
  lastModifiedById String?
  lastModifiedBy   User?   @relation("FileLastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)

  shares       Share[]
  accesses     FileAccess[]
  shortcuts    FileShortcut[]
  versions     FileVersion[]
  activityLogs ActivityLog[]

  @@unique([ownerId, telegramRef])
  @@index([ownerId, folderId])
  @@index([spaceId, folderId])
  @@index([deletedAt])
  @@index([ownerId, takenAt])
}

// A superseded content blob for a File, kept so a previous "upload new
// version" can be downloaded or restored. Only past content lives here — the
// live content stays on File.storageKey/size/mimeType so every other read
// path (streaming, thumbnails, zip) is untouched.
model FileVersion {
  id          String   @id @default(cuid())
  fileId      String
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  storageKey  String
  size        BigInt
  mimeType    String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([fileId, createdAt])
}

model Space {
  id           String   @id @default(cuid())
  name         String
  // CSS color (hex or named) used to tint the space in the sidebar and
  // dialog. Null falls back to a neutral default.
  color        String?
  // Storage key pointing to the uploaded logo image. Null means the UI
  // renders the default gradient-with-initial badge.
  logoKey      String?
  // Key from the curated icon set (see apps/web/src/lib/spaceIcons.tsx).
  // Mutually exclusive with logoKey in the UI — if both are set, logoKey
  // wins. Null means no icon selected.
  icon         String?
  ownerId      String
  owner        User     @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  rootFolderId String   @unique
  rootFolder   Folder   @relation("SpaceRoot", fields: [rootFolderId], references: [id])
  // When true, any authenticated DarkDrive user can read the space's contents.
  // Writes are still restricted to the owner and explicit EDITOR members.
  isPublic     Boolean  @default(false)
  // Whether the owner has pinned this space to their own sidebar. Mirrors
  // SpaceMember.pinned, which serves the same purpose for joined members —
  // owners have no SpaceMember row so they need their own copy of the flag.
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  members SpaceMember[]
  folders Folder[]
  files   File[]
  invites SpaceInvite[]
}

enum SpaceRole {
  VIEWER
  EDITOR
  ADMIN
}

// A shareable invite link — anyone with the token and a DarkDrive account
// can join the space at the given role, subject to the optional expiry and
// use-limit. Distinct from Space.isPublic: this grants access to spaces that
// aren't publicly discoverable, to whoever holds the link.
model SpaceInvite {
  id          String    @id @default(cuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  token       String    @unique
  role        SpaceRole @default(VIEWER)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  // Null means no limit / never expires.
  maxUses     Int?
  useCount    Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([spaceId])
}

model SpaceMember {
  id                String    @id @default(cuid())
  spaceId           String
  space             Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              SpaceRole @default(EDITOR)
  // What the member may do: the same two settings as FolderMember, adding and
  // changing, and deleting. Null on a row from before they existed and on one
  // made by joining or an invite link, and then `role` says: VIEWER is NO to
  // both, EDITOR YES. Whenever they are set `role` is kept in step (VIEWER
  // when canUpload is NO), for the "ask to upload" flow that reads it.
  // ponytail: two spellings of one thing, so old rows need no backfill under
  // `db push`. Drop `role` once there are migrations to fill these in with.
  canUpload         MemberCan?
  canDelete         MemberCan?
  // Whether this member has pinned the space to their own sidebar. Only
  // meaningful for non-owner members — owners always see their own spaces.
  pinned            Boolean   @default(false)
  // Set when a VIEWER asks the owner to be promoted to EDITOR (upload
  // rights). Null when there's no pending request — cleared on approve/deny.
  editorRequestedAt DateTime?
  joinedAt          DateTime  @default(now())

  @@unique([spaceId, userId])
}

enum SharePermission {
  VIEW
  EDIT
}

enum ShareResourceType {
  FILE
  FOLDER
}

model Share {
  id           String            @id @default(cuid())
  token        String            @unique
  resourceType ShareResourceType
  permission   SharePermission   @default(VIEW)
  fileId       String?
  file         File?             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?           @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt    DateTime?
  passwordHash String?
  // A folder link: whether it opens the folders inside it too, or only the
  // files right in it. Off by default, which is what links made before it were.
  includeSubfolders Boolean       @default(false)
  createdAt    DateTime          @default(now())

  @@index([createdById])
}

// A "link" of a file into another folder. Uploads into a shared space go into
// the uploader's drive and surface in the space folder via a shortcut, so the
// file's primary home is always the uploader's drive.
model FileShortcut {
  id        String   @id @default(cuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId  String
  folder    Folder   @relation("FolderShortcuts", fields: [folderId], references: [id], onDelete: Cascade)
  // Waiting on the space's owner, for a member who has to ask (SpaceMember),
  // like File.pending: "upload" is a link `pendingById` added, which nobody
  // else sees until the owner says yes; "delete" is one they want removed,
  // which stays until then. In a space it is the link that waits, since the
  // file it points at is in its uploader's own drive.
  pending     String?
  pendingById String?
  createdAt DateTime @default(now())

  @@unique([fileId, folderId])
  @@index([folderId])
}
